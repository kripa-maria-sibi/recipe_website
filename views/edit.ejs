<%- include("partials/header") %>

<section class="form-shell reveal">
  <h1>Edit Recipe</h1>
  <form class="recipe-form" method="POST" action="/recipes/<%= recipe.id %>?_method=PUT">
    <label>Title
      <input type="text" name="title" value="<%= recipe.title %>" required />
    </label>

    <label>Category
      <select name="category" required>
        <% categories.forEach((cat) => { %>
          <option value="<%= cat %>" <%= recipe.category === cat ? "selected" : "" %>>
            <%= cat.charAt(0).toUpperCase() + cat.slice(1) %>
          </option>
        <% }) %>
      </select>
    </label>

    <label>Prep Time (minutes)
      <input type="number" name="prepTime" min="1" value="<%= recipe.prepTime %>" required />
    </label>

    <label>Ingredients (comma separated)
      <textarea name="ingredients" rows="4" required><%= recipe.ingredients %></textarea>
    </label>

    <label>Instructions
      <textarea name="instructions" rows="6" required><%= recipe.instructions %></textarea>
    </label>

    <label>Photo URL
      <input type="text" name="imageUrl" value="<%= recipe.imageUrl || '' %>" placeholder="/images/your-recipe-photo.jpg or https://example.com/photo.jpg" />
    </label>

    <div class="form-actions">
      <button type="submit">Update Recipe</button>
      <a href="/recipes/<%= recipe.id %>" class="btn-secondary">Cancel</a>
    </div>
  </form>
</section>

<%- include("partials/footer") %>
